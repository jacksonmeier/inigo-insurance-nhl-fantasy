# Running the league on your own computer? You don't need this file:
# `npm run setup` writes .env.local for you. See docs/LOCAL.md.
#
# For a hosted Supabase project, copy this to .env.local and fill in from
# Supabase: Project Settings > API. Both values are public (they end up in the
# browser bundle). Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
